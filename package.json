{
  "name": "spidermonkey-installer",
  "displayName": "SpiderMonkey Installer",
  "description": "Simplify SpiderMonkey installation for developers",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:spidermonkeyInstaller.installSpiderMonkey"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spidermonkeyInstaller.installSpiderMonkey",
        "title": "Install SpiderMonkey"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "^16.11.7",
    "typescript": "^4.4.3",
    "vscode-test": "^1.5.2"
  },
  "dependencies": {
    "unzipper": "^0.10.11"
  }
}
